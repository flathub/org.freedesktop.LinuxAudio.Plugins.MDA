{
    "id": "org.freedesktop.LinuxAudio.Plugins.MDA",
    "branch": "26.08",
    "runtime": "org.freedesktop.LinuxAudio.BaseExtension",
    "runtime-version": "stable",
    "sdk": "org.freedesktop.Sdk//26.08",
    "build-extension": true,
    "build-options": {
        "prepend-pkg-config-path": "/app/extensions/Plugins/MDA/lib/pkgconfig",
        "prefix": "/app/extensions/Plugins/MDA"
    },
    "cleanup": [
        "/lib/lv2"
    ],
    "modules": [
        "shared-modules/linux-audio/lv2.json",
        {
            "name": "mda",
            "buildsystem": "meson",
            "config-opts": [
                "--libdir="
            ],
            "cleanup": [
                "/share/man"
            ],
            "post-install": [
                "strip ${FLATPAK_DEST}/lv2/*.lv2/*.so",
                "install -Dm644 ../org.freedesktop.LinuxAudio.Plugins.MDA.metainfo.xml -t ${FLATPAK_DEST}/share/metainfo",
                "install -Dm644 -t $FLATPAK_DEST/share/licenses/${FLATPAK_ID}/mda ../LICENSES/*"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.com/drobilla/mda-lv2.git",
                    "tag": "v1.2.12",
                    "commit": "fb85abef3e5400cc8b93fe79b727e8baef9f685c"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.LinuxAudio.Plugins.MDA.metainfo.xml"
                }
            ]
        }
    ]
}
